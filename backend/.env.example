# Copy this file to `.env` and fill in real values, then `source .env` (or use python-dotenv)
# before running `python run.py`.

SECRET_KEY=change-this-to-a-random-string
FRONTEND_ORIGIN=http://localhost:5173

# Optional: enables real AI generation in the AI Assistant page.
# Without this, the AI Assistant falls back to rule-based, offline responses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: override where the SQLite file is written.
STUDYOS_DB_PATH=studyos.db
