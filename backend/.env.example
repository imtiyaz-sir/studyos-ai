# Copy this file to `.env` and fill in real values, then `source .env` (or use python-dotenv)
# before running `python run.py`.

SECRET_KEY=change-this-to-a-random-string
FRONTEND_ORIGIN=http://localhost:5173
FLASK_ENV=development

# Optional: enables real AI generation in the AI Assistant page.
# Without this, the AI Assistant falls back to rule-based, offline responses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: override where the SQLite file is written.
STUDYOS_DB_PATH=studyos.db

# Optional: enables real verification/password-reset emails via SMTP.
# Without these, links are logged to the console and returned in the API
# response (dev_verification_url / dev_reset_url) so auth still works end
# to end with zero email setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
